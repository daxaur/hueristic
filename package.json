{
  "name": "hueristic",
  "version": "0.1.0",
  "description": "Weighted color theme solver — assign any number of colors to UI roles, get ranked accessible themes with previews and the reasoning",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./color": "./src/color.js",
    "./contrast": "./src/contrast.js"
  },
  "bin": {
    "hueristic": "bin/hueristic.js"
  },
  "files": ["src", "bin", "SKILL.md"],
  "scripts": {
    "test": "node --test test/",
    "assets": "node scripts/build-assets.mjs"
  },
  "keywords": [
    "color",
    "palette",
    "theme",
    "design-tokens",
    "accessibility",
    "apca",
    "oklch",
    "contrast"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daxaur/hueristic.git"
  }
}
